{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LYONIX-LAB",
  "version": "0.2.0",
  "identifier": "com.lyonix.lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LYONIX-LAB",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Small local LLM runtime and model manager",
    "longDescription": "Hardware-aware local LLM model and runtime manager with safe defaults."
  }
}
